.hero {
    height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--white);
    overflow: hidden;
    background: #1B5E20;
    /* Fallback */
}

.hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.hero-bg-image {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(46, 125, 50, 0.5), rgba(27, 94, 32, 0.7)),
        url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?ixlib=rb-1.2.1&auto=format&fit=crop&w=2500&q=80') center/cover;
    animation: kenBurns 20s ease-in-out infinite alternate;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1));
    z-index: 1;
}

/* Running Text Styles */
.running-text-container {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    z-index: 20;
    padding: 0 2rem;
    animation: slideDown 0.5s ease;
}

.running-text-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-radius: 60px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    padding: 0.6rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

.running-text-wrapper:hover {
    box-shadow: 0 20px 50px rgba(46, 125, 50, 0.3);
    transform: translateY(-2px);
}

.running-text-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary-color), var(--secondary-color), var(--primary-light));
    animation: gradientMove 3s linear infinite;
}

@keyframes gradientMove {
    0% {
        transform: translateX(-100%);
    }

    100% {
        transform: translateX(100%);
    }
}

.running-text-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
    padding: 0.6rem 1.8rem;
    border-radius: 40px;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.8px;
    white-space: nowrap;
    box-shadow: 0 6px 15px rgba(46, 125, 50, 0.3);
    z-index: 2;
    border: 1px solid rgba(255, 255, 255, 0.2);
    text-transform: uppercase;
}

.pulse-dot {
    width: 10px;
    height: 10px;
    background: #4CAF50;
    border-radius: 50%;
    animation: pulse 1.5s ease infinite;
    box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.5);
}

@keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7);
    }

    70% {
        box-shadow: 0 0 0 12px rgba(76, 175, 80, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(76, 175, 80, 0);
    }
}

.running-text-content {
    flex: 1;
    margin: 0 1.2rem;
    height: 44px;
    overflow: hidden;
    position: relative;
    border-radius: 8px;
}

.running-text-slider {
    display: flex;
    flex-direction: column;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    height: 100%;
}

.running-text-item {
    height: 44px;
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--text-dark);
    padding: 0 0.8rem;
    transition: all 0.3s ease;
    flex-shrink: 0;
    border-radius: 8px;
}

.running-text-item:hover {
    background: linear-gradient(90deg, rgba(46, 125, 50, 0.05), transparent);
    padding-left: 1.2rem;
}

.item-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}

.running-text-item:hover .item-icon {
    transform: rotate(360deg) scale(1.1);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);
}

.item-text {
    flex: 1;
    font-size: 0.98rem;
    font-weight: 500;
    color: #333;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.item-arrow {
    color: var(--primary-color);
    opacity: 0;
    transform: translateX(-15px);
    transition: all 0.3s ease;
    margin-right: 0.5rem;
}

.running-text-item:hover .item-arrow {
    opacity: 1;
    transform: translateX(0);
}

.running-text-controls {
    display: flex;
    gap: 0.5rem;
    margin-right: 1rem;
}

.control-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: 0;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}

.control-dot.active {
    width: 28px;
    border-radius: 14px;
}

.control-dot:hover {
    transform: scale(1.3);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.15);
}

.running-text-close {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    border: none;
    color: #666;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    line-height: 1;
}

.running-text-close:hover {
    background: var(--secondary-color);
    color: white;
    transform: rotate(90deg) scale(1.1);
    box-shadow: 0 4px 10px rgba(255, 143, 0, 0.4);
}

/* Tombol untuk menampilkan running text kembali */
.show-running-text-btn {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    color: white;
    border: none;
    border-radius: 40px;
    padding: 0.7rem 2rem;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    box-shadow: 0 10px 25px rgba(46, 125, 50, 0.4);
    animation: bounce 2s infinite;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
}

.show-running-text-btn:hover {
    transform: translateX(-50%) translateY(-3px);
    box-shadow: 0 15px 35px rgba(46, 125, 50, 0.5);
    background: linear-gradient(135deg, var(--primary-dark), var(--primary-color));
}

.pulse-dot-small {
    width: 10px;
    height: 10px;
    background: #FFD700;
    border-radius: 50%;
    animation: pulse 1.5s ease infinite;
}

/* Alert Banner */
.hero-alert {
    position: absolute;
    top: 100px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 15;
    width: 90%;
    max-width: 850px;
    background: linear-gradient(135deg, #FF8F00, #F57C00);
    border-radius: 60px;
    box-shadow: 0 15px 35px rgba(255, 143, 0, 0.4);
    animation: slideDown 0.5s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(5px);
}

.alert-content {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1rem 1.8rem;
    color: white;
    position: relative;
}

.alert-icon {
    font-size: 1.8rem;
    animation: bounce 2s infinite;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
}

@keyframes bounce {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-5px);
    }
}

.alert-text {
    flex: 1;
    font-size: 1rem;
    font-weight: 500;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
}

.alert-text strong {
    font-weight: 700;
    margin-right: 0.5rem;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 40px;
}

.alert-btn {
    background: rgba(255, 255, 255, 0.25);
    border: 2px solid rgba(255, 255, 255, 0.6);
    color: white;
    padding: 0.5rem 1.5rem;
    border-radius: 40px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    backdrop-filter: blur(5px);
    letter-spacing: 0.5px;
}

.alert-btn:hover {
    background: white;
    color: #F57C00;
    transform: scale(1.05);
    border-color: white;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}

.alert-close {
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    font-size: 1.8rem;
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.3s ease;
    line-height: 1;
}

.alert-close:hover {
    background: rgba(255, 255, 255, 0.4);
    transform: rotate(90deg) scale(1.1);
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    width: 90%;
    padding: 1rem;
    animation: fadeInUp 1s ease;
    margin-top: 40px;
}

.hero-title {
    font-size: 2rem;
    margin-bottom: 1rem;
    opacity: 0;
    animation: fadeInUp 1s ease forwards;
    animation-delay: 0.3s;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    font-weight: 500;
    letter-spacing: 1px;
}

.hero-subtitle {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    font-weight: 800;
    opacity: 0;
    animation: fadeInUp 1s ease forwards;
    animation-delay: 0.6s;
    text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.3);
    background: linear-gradient(45deg, #fff, #FFE0B2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
}

.hero-description {
    font-size: 1.3rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeInUp 1s ease forwards;
    animation-delay: 0.9s;
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.2);
    font-weight: 400;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

/* Hero Search Bar - Modern Design */
.hero-search-container {
    max-width: 700px;
    margin: 2.5rem auto;
    padding: 6px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 100px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    z-index: 20;
    position: relative;
    visibility: visible;
    opacity: 1;
}

.hero-search-container.focused {
    background: rgba(255, 255, 255, 0.25);
    box-shadow: 0 25px 60px rgba(46, 125, 50, 0.4);
    transform: translateY(-5px) scale(1.02);
    border-color: var(--secondary-color);
}

.hero-search-form {
    display: flex;
    align-items: center;
    width: 100%;
    padding-left: 1.5rem;
}

.search-input-group {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 1rem;
}

.search-icon {
    color: var(--secondary-color);
    filter: drop-shadow(0 0 8px rgba(255, 143, 0, 0.4));
}

.search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: white;
    font-size: 1.1rem;
    padding: 0.8rem 0;
    font-weight: 500;
}

.search-input::placeholder {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 400;
}

.search-submit-btn {
    background: linear-gradient(135deg, var(--secondary-color), #FFB300);
    color: white;
    border: none;
    padding: 0.9rem 2.5rem;
    border-radius: 100px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 20px rgba(255, 143, 0, 0.3);
}

.search-submit-btn:hover {
    transform: scale(1.05);
    background: linear-gradient(135deg, #FFB300, var(--secondary-color));
    box-shadow: 0 15px 30px rgba(255, 143, 0, 0.5);
}


/* Hero Contact Info */
.hero-contact-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
}

.hero-contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 40px;
    transition: all 0.3s ease;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(255, 255, 255, 0.5);
}

.hero-contact-item:hover {
    background: white;
    transform: translateX(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.hero-contact-icon {
    color: #2e7d32;
}

.hero-contact-link {
    color: #444;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: color 0.3s ease;
}

.hero-contact-link:hover {
    color: #2e7d32;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    opacity: 0;
    animation: fadeInUp 1s ease forwards;
    animation-delay: 2s;
    margin-top: 1rem;
}

.hero-buttons button {
    min-width: 180px;
    padding: 1rem 2rem;
    font-size: 1.1rem;
}

.hero-buttons .btn-primary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-content: center;
    background: linear-gradient(135deg, var(--secondary-color), #F57C00);
    border: none;
    box-shadow: 0 10px 20px rgba(255, 143, 0, 0.3);
}

.hero-buttons .btn-primary svg {
    transition: transform 0.3s ease;
}

.hero-buttons .btn-primary:hover svg {
    transform: translateX(8px);
}

.hero-buttons .btn-secondary {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(5px);
    border: 2px solid rgba(255, 255, 255, 0.6);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}

.hero-stats {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    padding: 2rem;
    z-index: 10;
    color: var(--text-dark);
    transform: translateY(100%);
    transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    border-top: 4px solid var(--secondary-color);
}

.hero-stats.animate-stats {
    transform: translateY(0);
}

.stat-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    padding: 1.2rem;
    border-right: 1px solid var(--gray);
    transition: all 0.3s ease;
    cursor: pointer;
}

.stat-item:hover {
    background: rgba(46, 125, 50, 0.05);
    transform: translateY(-5px);
}

.stat-item:last-child {
    border-right: none;
}

.stat-icon {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, var(--primary-light), var(--primary-color));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    animation: pulse 2s infinite;
    transition: all 0.5s ease;
    box-shadow: 0 10px 20px rgba(46, 125, 50, 0.2);
}

.stat-item:hover .stat-icon {
    transform: rotate(360deg) scale(1.1);
    background: linear-gradient(135deg, var(--secondary-color), var(--secondary-dark));
    box-shadow: 0 15px 30px rgba(255, 143, 0, 0.3);
}

.stat-info {
    text-align: left;
}

.stat-number {
    font-size: 2.2rem;
    color: var(--primary-dark);
    margin-bottom: 0.2rem;
    font-weight: 800;
    line-height: 1.2;
}

.stat-label {
    color: var(--text-light);
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive */
@media (max-width: 1200px) {
    .hero-subtitle {
        font-size: 2.8rem;
    }

    .running-text-wrapper {
        padding: 0.5rem 1rem;
    }

    .hero-search-section {
        margin: 1.5rem 1rem;
        padding: 1.5rem;
    }

    .hero-provinsi-title h3 {
        font-size: 1.5rem;
    }
}

@media (max-width: 1024px) {
    .hero-subtitle {
        font-size: 2.5rem;
    }

    .hero-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .stat-item:nth-child(2) {
        border-right: none;
    }

    .running-text-wrapper {
        flex-wrap: wrap;
        border-radius: 30px;
        padding: 0.8rem;
    }

    .running-text-label {
        width: 100%;
        justify-content: center;
        margin-bottom: 0.8rem;
        padding: 0.5rem 1rem;
    }

    .running-text-content {
        width: 100%;
        margin: 0.5rem 0;
    }

    .hero-alert {
        top: 120px;
    }

    .alert-content {
        flex-wrap: wrap;
        justify-content: center;
        text-align: center;
        gap: 0.8rem;
    }

    .alert-btn {
        width: 100%;
    }

    .item-text {
        white-space: normal;
        font-size: 0.9rem;
    }
}

@media (max-width: 768px) {
    .hero-title {
        font-size: 1.5rem;
    }

    .hero-subtitle {
        font-size: 2rem;
    }

    .hero-description {
        font-size: 1rem;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: center;
    }

    .hero-buttons button {
        width: 100%;
        min-width: unset;
    }

    .hero-stats {
        grid-template-columns: 1fr;
        padding: 1rem;
    }

    .stat-item {
        border-right: none;
        border-bottom: 1px solid var(--gray);
        justify-content: flex-start;
        padding: 1rem;
    }

    .stat-item:last-child {
        border-bottom: none;
    }

    .running-text-container {
        top: 10px;
        padding: 0 1rem;
    }

    .running-text-wrapper {
        padding: 0.6rem;
    }

    .running-text-item {
        padding: 0 0.5rem;
    }

    .hero-alert {
        top: 140px;
        width: 95%;
        border-radius: 30px;
    }

    .alert-content {
        padding: 1rem;
    }

    .alert-icon {
        font-size: 1.5rem;
    }

    .alert-text {
        font-size: 0.9rem;
    }

    .show-running-text-btn {
        top: 20px;
        padding: 0.6rem 1.5rem;
        font-size: 0.9rem;
    }

    /* Hero Search Responsive */
    .hero-search-section {
        padding: 1.2rem;
    }

    .hero-provinsi-title {
        flex-direction: column;
        gap: 0.3rem;
    }

    .hero-provinsi-icon {
        font-size: 1.6rem;
    }

    .hero-provinsi-title h3 {
        font-size: 1.3rem;
    }

    .hero-provinsi-title h3::after {
        width: 40px;
    }

    .hero-search-input {
        padding: 0.8rem 0.8rem;
        font-size: 0.9rem;
    }

    .hero-search-button {
        padding: 0.6rem 1.2rem;
        font-size: 0.9rem;
    }

    .hero-contact-social {
        flex-direction: column;
        gap: 1rem;
    }

    .hero-follow-us {
        text-align: center;
    }

    .hero-follow-title::after {
        left: 50%;
        transform: translateX(-50%);
    }

    .hero-social-icons {
        justify-content: center;
    }

    .hero-contact-info {
        align-items: center;
    }

    .hero-contact-item {
        width: 100%;
        justify-content: center;
    }

    .hero-contact-item:hover {
        transform: translateX(0) translateY(-3px);
    }
}

@media (max-width: 480px) {
    .hero-search-input-wrapper {
        flex-direction: column;
        border-radius: 30px;
        padding: 0.5rem;
    }

    .hero-search-icon {
        display: none;
    }

    .hero-search-input {
        width: 100%;
        text-align: center;
        padding: 0.8rem 0.5rem;
    }

    .hero-search-button {
        width: 100%;
        margin: 0.3rem 0 0 0;
        border-radius: 30px;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
    }

    .stat-number {
        font-size: 1.5rem;
    }
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
    .running-text-wrapper {
        background: rgba(30, 30, 30, 0.98);
    }

    .item-text {
        color: #eee;
    }

    .running-text-close {
        color: #aaa;
        background: rgba(255, 255, 255, 0.1);
    }

    .hero-search-section {
        background: rgba(30, 30, 30, 0.95);
    }

    .hero-provinsi-title h3 {
        color: #4caf50;
    }

    .hero-search-input {
        color: #eee;
    }

    .hero-search-input::placeholder {
        color: #888;
    }

    .hero-follow-title {
        color: #ccc;
    }

    .hero-contact-item {
        background: rgba(50, 50, 50, 0.8);
    }

    .hero-contact-link {
        color: #ddd;
    }
}